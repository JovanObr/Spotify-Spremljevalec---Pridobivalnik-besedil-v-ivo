
# Spotify API (https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Google Gemini API (https://aistudio.google.com/apikey)
# Optional: without a key the app works, just without AI facts.
GEMINI_API_KEY=
# Model for song facts: shown while a song plays, so a fast model is used
GEMINI_FACTS_MODEL=gemini-3.5-flash-lite
# Model for "If you like this" recommendations (Gemma has a larger free daily quota)
GEMINI_RECOMMENDATIONS_MODEL=gemma-4-31b-it

# Lyrics sources, tried in order (lrclib = synced lyrics, lyricsovh = plain backup)
LYRICS_PROVIDERS=lrclib,lyricsovh

# Prepare lyrics and facts for the next song in your queue (0 to turn off)
PREFETCH_NEXT=1
